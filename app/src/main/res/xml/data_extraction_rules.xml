<?xml version="1.0" encoding="utf-8"?>
<!--
  L'historique des séances est la donnée la plus précieuse de l'application :
  on l'inclut explicitement dans les sauvegardes cloud et les transferts d'appareil.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
